---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const routes = [
  {
    from: "Depuis Bruxelles",
    steps: [
      "Autoroute de Mons / Paris jusqu'à la sortie 20 (Ronquière-Feluy).",
      "Passez sous l'autoroute, direction Thuin (N59).",
      "Suivez Lobbes ; la route descend fort — il reste ≈ 5 km.",
      "Tout en bas, épingle à cheveux à droite. Ne franchissez ni le pont du chemin de fer, ni celui de la Sambre : passez sous la portelette.",
      "Première à gauche après la portelette, sur 1,3 km.",
      "Prenez la petite route fléchée « Sars-la-Buissière ».",
      "Au village, à la graineterie, tournez à gauche vers le château.",
    ],
  },
  {
    from: "Depuis Liège & Namur",
    steps: [
      "Empruntez la dorsale wallonne, direction Mons.",
      "Sortie 18 bis, direction Thuin (N59).",
      "Rejoignez ensuite l'itinéraire par Lobbes.",
    ],
  },
  {
    from: "Depuis Charleroi",
    steps: [
      "Rejoignez la N59 via la N90 ou la N54 (Ring 3, sortie 3), direction Lobbes.",
      "Empruntez la N59, direction Thuin.",
      "Dans Lobbes, rejoignez l'itinéraire principal.",
    ],
  },
];
---

<Layout
  title="Venir ici — Tourne-Bride"
  description="Comment rejoindre Tourne-Bride à Sars-la-Buissière : adresse, coordonnées GPS et itinéraires depuis Bruxelles, Liège, Namur et Charleroi."
>
  <Navbar />
  <main>
    <PageHero
      eyebrow="Venir ici"
      title="Comment nous rejoindre"
      subtitle="« Laissez venir à moi les petits enfants » (Luc 18.16) — et une bonne carte n'a jamais fait de mal !"
    />

    <!-- Adresse & GPS -->
    <section class="bg-cream py-[100px]">
      <div class="container-site">
        <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
          <div data-reveal class="rounded-[28px] bg-cream-2 p-9">
            <div class="font-display text-[18px] text-forest/70">Adresse</div>
            <h2 class="mt-2 font-display text-[30px] leading-[1.1] text-forest lg:text-[38px]">
              Château Grignard
            </h2>
            <p class="mt-3 font-heading text-[20px] leading-[30px] text-moss">
              Chevesne 95<br />6542 Sars-la-Buissière<br />Belgique
            </p>
          </div>
          <div data-reveal data-reveal-delay="0.08" class="rounded-[28px] bg-forest p-9 text-white">
            <div class="font-display text-[18px] text-lime">Coordonnées GPS</div>
            <div class="mt-3 space-y-1 font-heading text-[22px] font-bold">
              <div>Latitude : N 50°20.091'</div>
              <div>Longitude : E 4°13.660'</div>
            </div>
            <p class="mt-4 font-heading text-[17px] leading-[24px] text-mist">
              ⚠️ La plupart des GPS se trompent et indiquent « Rue Bois de Beau ».
              Entrez plutôt ces coordonnées pour arriver directement à l'entrée
              de la propriété.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Itinéraires -->
    <section class="bg-cream-2 py-[100px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-3 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            En voiture
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[60px] lg:leading-[64px]"
          >
            Les itinéraires
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-6 lg:grid-cols-3" data-stagger>
          {
            routes.map((r) => (
              <div data-reveal class="rounded-[24px] bg-cream p-8">
                <h3 class="font-display text-[24px] leading-none text-forest">{r.from}</h3>
                <ol class="mt-5 space-y-3">
                  {r.steps.map((s, i) => (
                    <li class="flex gap-3 font-heading text-[17px] leading-[24px] text-moss">
                      <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-lime font-bold text-[13px] text-forest">
                        {i + 1}
                      </span>
                      {s}
                    </li>
                  ))}
                </ol>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Train & vélo -->
    <section class="bg-forest py-[80px]">
      <div class="container-site max-w-[820px] text-center">
        <h2 data-reveal class="font-display text-[30px] leading-[1.1] text-white lg:text-[44px]">
          En train & à vélo
        </h2>
        <p data-reveal data-reveal-delay="0.08" class="mx-auto mt-5 max-w-[620px] font-heading text-[20px] leading-[32px] text-mist">
          Gare et location de vélos à Lobbes. Le domaine jouxte le sentier GR 129
          et le Ravel qui longe la Sambre — idéal pour arriver au grand air.
        </p>
      </div>
    </section>

    <CtaBand
      title="Une question sur l'accès ?"
      text="Appelez-nous, on vous guide jusqu'à Tourne-Bride."
      buttonLabel="Nous contacter"
      buttonHref="/contact"
    />
  </main>
  <Footer />
</Layout>
