---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const BASE = import.meta.env.BASE_URL;
const withBase = (p) => BASE + String(p).replace(/^\//, "");

const activities = [
  {
    title: "Partages bibliques & veillées",
    text: "Chaque soir, un temps de partage, des histoires et des veillées pour grandir ensemble.",
  },
  {
    title: "Grands jeux & sport",
    text: "Grands jeux, défis en équipe et activités de plein air dans la plaine et le bosquet.",
  },
  {
    title: "Nature & découvertes",
    text: "Balades, observation de la faune et découverte du domaine, entre Sambre et forêt.",
  },
  {
    title: "Arts & créations",
    text: "Peinture sur soie, linogravure, batik, gravure : place à l'imagination et au fait-main.",
  },
  {
    title: "Bons repas",
    text: "Des repas copieux, savoureux et variés, préparés avec soin pour toute la maisonnée.",
  },
  {
    title: "Bons couchages",
    text: "Un bâtiment agréé, bien chauffé et ventilé selon les saisons, pour des nuits paisibles.",
  },
];

const steps = [
  {
    title: "Se renseigner",
    text: "Vérifiez les places encore disponibles pour le prochain camp au 0496 18 14 14.",
  },
  {
    title: "Remplir le talon",
    text: "Complétez le talon d'inscription et la fiche signalétique et médicale, en ligne ou par courrier.",
  },
  {
    title: "Verser l'acompte",
    text: "Virez le montant sur le compte BE52 0882 1037 5009 (nom de l'enfant + n° de téléphone en communication).",
  },
  {
    title: "Préparer le trousseau",
    text: "Recevez le trousseau et préparez tranquillement les affaires de votre enfant.",
  },
];

const facts = [
  ["Âge", "7 à 11 ans"],
  ["Prix", "115 € / enfant"],
  ["Fratrie", "215 € pour 2 enfants"],
  ["Lieu", "Château Grignard, Sars-la-Buissière"],
];
---

<Layout
  title="Nos camps — Tourne-Bride"
  description="Séjours résidentiels pour enfants de 7 à 11 ans : jeux, nature, arts, partages bibliques et veillées, dans un cadre sûr et chaleureux. Depuis 1964."
>
  <Navbar />
  <main>
    <PageHero
      eyebrow="Nos camps"
      title="Des séjours qui font grandir"
      subtitle="Pour les enfants de 7 à 11 ans : jeux, nature, créations et partages bibliques, dans un cadre sûr et chaleureux. Comme un camp, avec un vrai esprit de famille."
      image="EtEKI00462QzvuEC2cekaszNQ.png"
    />

    <!-- Présentation -->
    <section class="bg-cream py-[100px]">
      <div class="container-site">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div>
            <span
              data-reveal
              class="inline-block -rotate-3 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
            >
              L'esprit Tourne-Bride
            </span>
            <h2
              data-reveal
              data-reveal-delay="0.05"
              class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[60px] lg:leading-[64px]"
            >
              Des colonies pas comme les autres
            </h2>
          </div>
          <div data-reveal data-reveal-delay="0.1">
            <p class="font-heading text-[20px] leading-[32px] text-moss">
              Depuis 1964, « L'Évangile aux Enfants » organise à Tourne-Bride des
              séjours résidentiels de quelques jours. On y joue, on explore, on
              crée et on partage, encadré par une équipe attentive.
            </p>
            <p class="mt-4 font-heading text-[20px] leading-[32px] text-moss">
              Le tout dans le respect de la liberté de conscience de chaque
              enfant et de sa famille.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Ce qu'on y vit -->
    <section class="bg-forest py-[110px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-2 rounded-md bg-lime px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Au programme
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-white lg:text-[64px] lg:leading-[68px]"
          >
            Ce qu'on y vit
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {
            activities.map((a) => (
              <div data-reveal class="rounded-[24px] bg-white/5 p-8">
                <h3 class="font-display text-[24px] leading-none text-lime">{a.title}</h3>
                <p class="mt-4 font-heading text-[18px] leading-[27px] text-mist">{a.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Comment s'inscrire -->
    <section class="bg-cream-2 py-[100px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-3 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Inscription
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[64px] lg:leading-[68px]"
          >
            Comment inscrire votre enfant
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          {
            steps.map((s, i) => (
              <div data-reveal class="rounded-[24px] bg-cream p-8">
                <span class="flex h-11 w-11 items-center justify-center rounded-full bg-lime font-display text-[20px] text-forest">
                  {i + 1}
                </span>
                <h3 class="mt-5 font-heading text-[22px] font-extrabold text-forest">
                  {s.title}
                </h3>
                <p class="mt-3 font-heading text-[17px] leading-[25px] text-moss">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Infos pratiques -->
    <section class="bg-cream py-[100px]">
      <div class="container-site">
        <div class="grid grid-cols-1 gap-12 lg:grid-cols-2">
          <!-- Faits -->
          <div>
            <span
              data-reveal
              class="inline-block -rotate-2 rounded-md bg-lime px-3 py-1 font-display text-[18px] leading-none text-forest"
            >
              En pratique
            </span>
            <h2
              data-reveal
              data-reveal-delay="0.05"
              class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[56px] lg:leading-[60px]"
            >
              Les infos essentielles
            </h2>
            <dl class="mt-8 divide-y divide-forest/10" data-reveal data-reveal-delay="0.1">
              {
                facts.map(([k, v]) => (
                  <div class="flex items-baseline justify-between gap-6 py-4">
                    <dt class="font-heading text-[18px] text-moss">{k}</dt>
                    <dd class="text-right font-heading text-[20px] font-bold text-forest">{v}</dd>
                  </div>
                ))
              }
            </dl>
          </div>

          <!-- Le prix n'est jamais un obstacle -->
          <div class="flex flex-col gap-6">
            <div data-reveal="scale" class="rounded-[28px] bg-forest p-9 text-white">
              <h3 class="font-display text-[26px] leading-[1.1] lg:text-[32px]">
                Le prix n'est jamais un obstacle
              </h3>
              <p class="mt-4 font-heading text-[18px] leading-[27px] text-mist">
                Le prix ne nous permet aucun bénéfice, au contraire, et ne peut
                jamais empêcher un enfant de participer. Parlez-nous-en en toute
                confiance.
              </p>
            </div>
            <div data-reveal class="rounded-[28px] bg-cream-2 p-9">
              <h3 class="font-display text-[24px] leading-[1.1] text-forest">
                Aides & remboursements
              </h3>
              <p class="mt-4 font-heading text-[18px] leading-[26px] text-moss">
                Renseignez-vous auprès de votre mutuelle, du CPAS ou de votre
                employeur : une attestation de séjour est remise à chaque
                campeur. Le bâtiment est agréé aux normes de sécurité et
                d'hygiène de la Fédération Wallonie-Bruxelles.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <CtaBand
      title="Une place pour votre enfant cet été ?"
      text="Renseignez-vous sur les prochains camps et réservez sa place. Nous répondons à toutes vos questions."
      buttonLabel="Nous contacter"
      buttonHref="/contact"
    />
  </main>
  <Footer />
</Layout>
