---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
---

<Layout title="Mentions légales — Tourne-Bride" description="Mentions légales du Centre Protestant Tourne-Bride ASBL.">
  <Navbar />
  <main>
    <PageHero eyebrow="Informations" title="Mentions légales" />

    <section class="bg-cream py-[90px]">
      <div class="container-site max-w-[820px] space-y-10">
        <div data-reveal>
          <h2 class="font-display text-[26px] text-forest">Éditeur du site</h2>
          <p class="mt-3 font-heading text-[18px] leading-[28px] text-moss">
            Centre Protestant Tourne-Bride ASBL (« L'Évangile Aux Enfants »)<br />
            Château Grignard — Chevesne 95, 6542 Sars-la-Buissière, Belgique<br />
            Téléphone : 071 59 19 61 · 0496 18 14 14<br />
            Email : yvan.dussart@tourne-bride.be
          </p>
        </div>
        <div data-reveal>
          <h2 class="font-display text-[26px] text-forest">Objet de l'association</h2>
          <p class="mt-3 font-heading text-[18px] leading-[28px] text-moss">
            L'ASBL a pour objectif l'épanouissement général des enfants — sur les
            plans moral, psychologique et spirituel — dans le respect de la liberté
            de conscience de l'enfant et de sa famille. Elle organise des camps,
            un internat et met des bâtiments en location depuis 1964.
          </p>
        </div>
        <div data-reveal>
          <h2 class="font-display text-[26px] text-forest">Propriété intellectuelle</h2>
          <p class="mt-3 font-heading text-[18px] leading-[28px] text-moss">
            Les contenus de ce site (textes, images, logo) sont la propriété du
            Centre Protestant Tourne-Bride ASBL, sauf mention contraire. Toute
            reproduction sans autorisation est interdite.
          </p>
        </div>
        <div data-reveal>
          <h2 class="font-display text-[26px] text-forest">Contact</h2>
          <p class="mt-3 font-heading text-[18px] leading-[28px] text-moss">
            Pour toute question relative à ce site, écrivez-nous à
            <a href="mailto:yvan.dussart@tourne-bride.be" class="font-bold text-orange hover:underline">yvan.dussart@tourne-bride.be</a>.
          </p>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
