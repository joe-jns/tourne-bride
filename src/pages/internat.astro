---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const week = [
  { day: "Lundi", text: "On se réinstalle, on vérifie les cartables et les connaissances." },
  { day: "Mardi", text: "Bricolage et jeux de coopération. À l'école à vélo." },
  { day: "Mercredi", text: "Deux heures d'athlétisme au Moha. À l'école à vélo." },
  { day: "Jeudi", text: "Natation et escalade en alternance. À l'école à vélo." },
  { day: "Vendredi", text: "Retour en famille pour le week-end." },
];

const benefits = [
  { title: "Réussite scolaire", text: "Une méthode de travail qui te convient, le développement de la mémoire et l'enrichissement du vocabulaire." },
  { title: "Bien-être", text: "Apprendre à gérer ses émotions et son stress, dans une micro-société de 6 enfants maximum." },
  { title: "Épanouissement spirituel", text: "Veillées, culte familial et différents modes d'expression, pour mieux comprendre l'amour de Dieu." },
  { title: "Ouverture linguistique", text: "Un apprentissage ludique du néerlandais, pour s'ouvrir à une autre culture de notre pays." },
  { title: "Une assiette équilibrée", text: "Quatre repas copieux, savoureux et variés par jour, et des collations pensées pour la diététique." },
  { title: "Sport & motricité", text: "Athlétisme, natation et escalade réguliers : « écran ? pas le temps ! »" },
];
---

<Layout
  title="Internat Sportif Marie Durand — Tourne-Bride"
  description="Le seul internat protestant de Belgique. Une toute petite structure pour élèves du primaire : sport, méthode de travail, veillées et vie de famille toute l'année scolaire."
>
  <Navbar />
  <main>
    <PageHero
      eyebrow="Internat"
      title="L'Internat Sportif Marie Durand"
      subtitle="Le seul internat protestant de Belgique — comme un camp, mais pendant toute l'année scolaire."
      image="32Or07csTLkfVEYnNPw2RlCkNg.png"
    />

    <!-- Intro -->
    <section class="bg-cream py-[100px]">
      <div class="container-site">
        <div class="grid grid-cols-1 items-center gap-12 lg:grid-cols-2">
          <div>
            <span
              data-reveal
              class="inline-block -rotate-3 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
            >
              Une grande famille
            </span>
            <h2
              data-reveal
              data-reveal-delay="0.05"
              class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[60px] lg:leading-[64px]"
            >
              Une toute petite structure, une vraie famille
            </h2>
          </div>
          <div data-reveal data-reveal-delay="0.1">
            <p class="font-heading text-[20px] leading-[32px] text-moss">
              De 5 à 8 enfants maximum, accueil exclusif des élèves du primaire :
              chacun reçoit un accompagnement spécifique, dans une ambiance
              chaleureuse. On y grandit à son rythme, entouré et encouragé.
            </p>
            <p class="mt-4 font-heading text-[20px] leading-[32px] text-moss">
              Depuis plus de 24 ans, l'Internat a accueilli des dizaines d'enfants
              — et continue d'écrire son histoire.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Une semaine type -->
    <section class="bg-forest py-[120px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-3 rounded-md bg-lime px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Le rythme
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-white lg:text-[60px] lg:leading-[64px]"
          >
            Une semaine à l'internat
          </h2>
          <p
            data-reveal
            data-reveal-delay="0.1"
            class="mt-5 max-w-[560px] font-heading text-[20px] leading-[32px] text-mist"
          >
            Et chaque soir : veillée, solidarité et partage des joies… et des
            petits bobos.
          </p>
        </div>
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-5" data-stagger>
          {
            week.map((d, i) => (
              <div data-reveal class="rounded-[22px] bg-white/5 p-6">
                <div class="font-display text-[16px] text-lime">{`Jour 0${i + 1}`}</div>
                <h3 class="mt-2 font-heading text-[22px] font-extrabold text-white">{d.day}</h3>
                <p class="mt-3 font-heading text-[17px] leading-[24px] text-mist">{d.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Ce que l'internat apporte -->
    <section class="bg-cream-2 py-[100px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-2 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Les atouts
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[64px] lg:leading-[68px]"
          >
            Ce que l'internat apporte
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-stagger>
          {
            benefits.map((b) => (
              <div data-reveal class="rounded-[24px] bg-cream p-8">
                <h3 class="font-display text-[24px] leading-none text-forest">{b.title}</h3>
                <p class="mt-4 font-heading text-[18px] leading-[26px] text-moss">{b.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Citation Nadine -->
    <section class="bg-lime py-[90px]">
      <div class="container-site max-w-[900px] text-center">
        <p
          data-reveal
          class="font-display text-[30px] leading-[1.15] text-forest lg:text-[44px] lg:leading-[1.1]"
        >
          «&nbsp;L'Internat Sportif Marie Durand n'est ni une prison, ni une
          punition : c'est un choix, un privilège pour une autre façon de
          s'élever.&nbsp;»
        </p>
        <div
          data-reveal
          data-reveal-delay="0.1"
          class="mt-6 font-heading text-[20px] font-bold text-forest/80"
        >
          — Tante Nadine
        </div>
      </div>
    </section>

    <CtaBand
      title="Envie d'en savoir plus sur l'internat ?"
      text="Renseignez-vous sans engagement — nous répondons à toutes vos questions au 0496 18 14 14."
      buttonLabel="Nous contacter"
      buttonHref="/contact"
    />
  </main>
  <Footer />
</Layout>
