---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";

const withBase = (p) => import.meta.env.BASE_URL + String(p).replace(/^\//, "");

const seasons = [
  {
    season: "Automne",
    period: "Congé de Toussaint",
    text: "Un camp résidentiel de quelques jours pour les 7 à 11 ans : jeux, veillées et créations, bien au chaud.",
    icon: "leaf",
  },
  {
    season: "Hiver",
    period: "Congé de détente",
    text: "Grands jeux d'intérieur, ateliers créatifs et bons repas pendant que le froid s'installe dehors.",
    icon: "snow",
  },
  {
    season: "Printemps",
    period: "Vacances de printemps",
    text: "La nature s'éveille : balades, découvertes et grand air sur le domaine de la Haute Sambre.",
    icon: "sprout",
  },
  {
    season: "Été",
    period: "Grandes vacances",
    text: "Le grand rendez-vous de l'année, en plein cœur de la nature, entre Sambre et forêt.",
    icon: "sun",
  },
];

const yearRound = [
  {
    title: "L'Internat",
    text: "L'Internat Sportif Marie Durand accueille les élèves du primaire toute l'année scolaire.",
    href: "/internat",
    cta: "Découvrir l'internat",
  },
  {
    title: "Les locations",
    text: "Le chalet, le château et le centre d'hébergement se réservent tout au long de l'année.",
    href: "/locations",
    cta: "Voir les locations",
  },
];
---

<Layout
  title="Calendrier — Tourne-Bride"
  description="Le rythme de l'année à Tourne-Bride : des camps pendant les vacances scolaires, un internat et des locations toute l'année."
>
  <Navbar />
  <main>
    <PageHero
      eyebrow="Calendrier"
      title="Nos rendez-vous de l'année"
      subtitle="Les camps rythment les vacances scolaires ; l'internat et les locations, eux, vous accueillent toute l'année."
    />

    <!-- Au fil des saisons -->
    <section class="bg-cream py-[100px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-3 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Au fil des saisons
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[64px] lg:leading-[68px]"
          >
            Les camps, au rythme des vacances
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4" data-stagger>
          {
            seasons.map((s) => (
              <div data-reveal class="rounded-[24px] bg-cream-2 p-8">
                <span class="flex h-12 w-12 items-center justify-center rounded-full bg-lime text-forest">
                  {s.icon === "leaf" && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 20c0-9 7-15 16-15 0 9-7 15-16 15zM4 20c4-5 8-8 12-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === "snow" && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  )}
                  {s.icon === "sprout" && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M12 21v-9m0 0C12 8 9.5 6 6 6c0 3.5 2.5 6 6 6zm0 0c0-4 2.5-6 6-6 0 3.5-2.5 6-6 6z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                  )}
                  {s.icon === "sun" && (
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.8"/><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M5 5l1.7 1.7M17.3 17.3L19 19M19 5l-1.7 1.7M6.7 17.3 5 19" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
                  )}
                </span>
                <div class="mt-5 font-display text-[15px] uppercase tracking-wide text-lime">
                  {s.season}
                </div>
                <h3 class="mt-1 font-heading text-[22px] font-extrabold text-forest">
                  {s.period}
                </h3>
                <p class="mt-3 font-heading text-[17px] leading-[25px] text-moss">{s.text}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Dates exactes -->
    <section class="bg-forest py-[90px]">
      <div class="container-site">
        <div
          class="mx-auto max-w-[820px] rounded-[28px] bg-white/5 p-10 text-center lg:p-12"
          data-reveal
        >
          <h2 class="font-display text-[30px] leading-[1.1] text-white lg:text-[42px]">
            Les dates du prochain camp ?
          </h2>
          <p class="mx-auto mt-5 max-w-[560px] font-heading text-[20px] leading-[30px] text-mist">
            Elles sont confirmées sur demande, selon les périodes et les places
            disponibles. Appelez-nous au 0496 18 14 14 ou consultez la page de
            nos camps.
          </p>
          <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
            <a
              href={withBase("/camps")}
              class="group relative overflow-hidden rounded-full bg-orange px-8 py-[16px]"
            >
              <span class="relative z-10 font-heading text-[20px] font-bold text-white">
                Voir nos camps
              </span>
              <span class="absolute inset-0 z-0 origin-bottom scale-y-0 bg-[#e05200] transition-transform duration-300 ease-out group-hover:scale-y-100" />
            </a>
            <a
              href="tel:+32496181414"
              class="rounded-full border-2 border-white/70 px-8 py-[14px] font-heading text-[20px] font-bold text-white transition-colors duration-300 hover:bg-white hover:text-forest"
            >
              0496 18 14 14
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Toute l'année -->
    <section class="bg-cream-2 py-[100px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-2 rounded-md bg-lime px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Toute l'année
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[64px] lg:leading-[68px]"
          >
            Tourne-Bride vit en continu
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2" data-stagger>
          {
            yearRound.map((y) => (
              <div data-reveal class="flex flex-col rounded-[28px] bg-cream p-9">
                <h3 class="font-display text-[28px] leading-none text-forest">{y.title}</h3>
                <p class="mt-4 font-heading text-[19px] leading-[28px] text-moss">{y.text}</p>
                <a
                  href={withBase(y.href)}
                  class="mt-6 inline-block font-heading text-[18px] font-bold text-orange hover:underline"
                >
                  {y.cta} →
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand
      title="Envie de réserver une date ?"
      text="Contactez-nous pour connaître les prochains camps ou vérifier les disponibilités."
      buttonLabel="Nous contacter"
      buttonHref="/contact"
    />
  </main>
  <Footer />
</Layout>
