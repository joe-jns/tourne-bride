---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { agenda, toDate, formatRange, moisNom } from "../data/agenda.js";

const withBase = (p) => import.meta.env.BASE_URL + String(p).replace(/^\//, "");

const WD = ["L", "M", "M", "J", "V", "S", "D"];

// Months spanned by at least one event
const monthKeys = new Set();
for (const e of agenda) {
  let d = new Date(toDate(e.start).getFullYear(), toDate(e.start).getMonth(), 1);
  const en = toDate(e.end || e.start);
  while (d <= en) {
    monthKeys.add(d.getFullYear() + "-" + d.getMonth());
    d = new Date(d.getFullYear(), d.getMonth() + 1, 1);
  }
}

function monthCells(y, m) {
  const startDay = (new Date(y, m, 1).getDay() + 6) % 7; // Monday = 0
  const days = new Date(y, m + 1, 0).getDate();
  const cells = [];
  for (let i = 0; i < startDay; i++) cells.push(null);
  for (let d = 1; d <= days; d++) cells.push(d);
  while (cells.length % 7) cells.push(null);
  return cells;
}
function eventsOn(y, m, d) {
  const dt = new Date(y, m, d).getTime();
  return agenda.filter((e) => {
    const s = toDate(e.start).getTime();
    const en = toDate(e.end || e.start).getTime();
    return dt >= s && dt <= en;
  });
}

const months = [...monthKeys]
  .map((k) => k.split("-").map(Number))
  .sort((a, b) => a[0] - b[0] || a[1] - b[1])
  .map(([y, m]) => ({
    y,
    m,
    cells: monthCells(y, m),
    list: agenda
      .filter((e) => {
        const s = toDate(e.start);
        return s.getFullYear() === y && s.getMonth() === m;
      })
      .sort((a, b) => toDate(a.start).getTime() - toDate(b.start).getTime()),
  }));

const yearRound = [
  { title: "L'Internat", text: "L'Internat Sportif Marie Durand accueille les élèves du primaire toute l'année scolaire.", href: "/internat", cta: "Découvrir l'internat" },
  { title: "Les locations", text: "Le chalet, le château et le centre d'hébergement se réservent tout au long de l'année.", href: "/locations", cta: "Voir les locations" },
];
---

<Layout
  title="Calendrier — Tourne-Bride"
  description="Le calendrier des camps et événements de Tourne-Bride. Retrouvez toutes les dates à venir en un coup d'œil."
>
  <Navbar />
  <main>
    <PageHero
      eyebrow="Calendrier"
      title="Toutes les dates en un coup d'œil"
      subtitle="Les camps et les événements de Tourne-Bride, posés sur le calendrier. Cliquez sur « Nos camps » pour le détail et l'inscription."
    />

    <!-- Calendrier -->
    <section class="bg-cream py-[100px]">
      <div class="container-site">
        <!-- Légende -->
        <div class="mb-10 flex flex-wrap items-center gap-6" data-reveal>
          <span class="flex items-center gap-2 font-heading text-[16px] text-moss">
            <span class="h-3.5 w-3.5 rounded-full bg-lime"></span> Camp
          </span>
          <span class="flex items-center gap-2 font-heading text-[16px] text-moss">
            <span class="h-3.5 w-3.5 rounded-full bg-amber"></span> Événement
          </span>
        </div>

        {
          months.length === 0 ? (
            <div class="rounded-[28px] bg-cream-2 p-10 text-center">
              <p class="font-heading text-[20px] text-moss">
                Aucune date programmée pour le moment. Contactez-nous au 0496 18 14 14.
              </p>
            </div>
          ) : (
            <div class="grid grid-cols-1 gap-8 md:grid-cols-2" data-stagger>
              {months.map(({ y, m, cells, list }) => (
                <div data-reveal class="rounded-[28px] bg-cream-2 p-6 lg:p-8">
                  <h2 class="font-display text-[26px] capitalize leading-none text-forest lg:text-[30px]">
                    {moisNom(m)} {y}
                  </h2>

                  <div class="mt-6 grid grid-cols-7 gap-1 text-center">
                    {WD.map((w) => (
                      <div class="py-1 font-heading text-[13px] font-bold text-moss/60">{w}</div>
                    ))}
                    {cells.map((d) => {
                      if (d === null) return <div />;
                      const evs = eventsOn(y, m, d);
                      const isCamp = evs.some((e) => e.type === "Camp");
                      const isEvent = evs.length > 0 && !isCamp;
                      return (
                        <div
                          class:list={[
                            "flex h-10 items-center justify-center rounded-lg font-heading text-[15px]",
                            isCamp && "bg-lime font-bold text-forest",
                            isEvent && "bg-amber font-bold text-forest",
                            evs.length === 0 && "text-forest/60",
                          ]}
                        >
                          {d}
                        </div>
                      );
                    })}
                  </div>

                  <div class="mt-6 space-y-3 border-t border-forest/10 pt-5">
                    {list.map((e) => (
                      <div class="flex items-start gap-3">
                        <span
                          class:list={[
                            "mt-1.5 h-3 w-3 shrink-0 rounded-full",
                            e.type === "Camp" ? "bg-lime" : "bg-amber",
                          ]}
                        />
                        <div>
                          <div class="font-heading text-[17px] font-bold text-forest">{e.title}</div>
                          <div class="font-heading text-[15px] text-moss">
                            {formatRange(e)}
                            {e.type === "Camp" && e.ageMin ? ` · ${e.ageMin}-${e.ageMax} ans` : ""}
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          )
        }

        <p data-reveal class="mt-8 font-heading text-[17px] text-moss/80">
          Le détail de chaque camp (âge, prix, inscription) se trouve sur la page{" "}
          <a href={withBase("/camps")} class="font-bold text-orange hover:underline">
            Nos camps
          </a>.
        </p>
      </div>
    </section>

    <!-- Toute l'année -->
    <section class="bg-cream-2 py-[100px]">
      <div class="container-site">
        <div class="mb-12 max-w-[760px]">
          <span
            data-reveal
            class="inline-block -rotate-2 rounded-md bg-lime px-3 py-1 font-display text-[18px] leading-none text-forest"
          >
            Toute l'année
          </span>
          <h2
            data-reveal
            data-reveal-delay="0.05"
            class="mt-4 font-display text-[40px] leading-[1.05] text-forest lg:text-[64px] lg:leading-[68px]"
          >
            Tourne-Bride vit en continu
          </h2>
        </div>
        <div class="grid grid-cols-1 gap-8 md:grid-cols-2" data-stagger>
          {
            yearRound.map((y) => (
              <div data-reveal class="flex flex-col rounded-[28px] bg-cream p-9">
                <h3 class="font-display text-[28px] leading-none text-forest">{y.title}</h3>
                <p class="mt-4 font-heading text-[19px] leading-[28px] text-moss">{y.text}</p>
                <a
                  href={withBase(y.href)}
                  class="mt-6 inline-block font-heading text-[18px] font-bold text-orange hover:underline"
                >
                  {y.cta} →
                </a>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <CtaBand
      title="Envie de réserver une date ?"
      text="Contactez-nous pour connaître les prochains camps ou vérifier les disponibilités."
      buttonLabel="Nous contacter"
      buttonHref="/contact"
    />
  </main>
  <Footer />
</Layout>
