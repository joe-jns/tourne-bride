---
const photos = [
  "iruQnLwvZWg9oZ9p8v8C1TtjGc0.png",
  "B1sLuaDnhAaAd4mXSCg1YssuI.png",
  "kzEDyqEFAkof4BfSLyRWAAkuEPk.png",
  "qFs5i7QhaWE1lH64m2t6A7BOHW8.png",
  "R34KiTv2HaS3kOcUvWBsgCilMVA.png",
  "wZsArgf4j4rjNmwPMG9M2fmsuuc.png",
];
---

<section class="relative overflow-hidden bg-forest pt-[80px]">
  <h2
    data-reveal
    class="text-center font-display text-[36px] leading-tight text-white lg:text-[56px]"
  >
    La vie à <span class="underline decoration-2 underline-offset-4">Tourne-Bride</span> en images
  </h2>

  <div class="mt-12 overflow-hidden" data-marquee data-marquee-speed="40">
    <div class="flex w-max gap-6 px-3" data-marquee-track>
      {
        photos.map((p) => (
          <img
            src={`${import.meta.env.BASE_URL}images/${p}`}
            alt=""
            aria-hidden="true"
            class="h-[290px] w-[290px] shrink-0 rounded-[20px] object-cover"
          />
        ))
      }
    </div>
  </div>
</section>
