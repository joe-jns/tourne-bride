---
---

<section
  class="relative flex min-h-[755px] flex-col items-center justify-center overflow-hidden pb-20 pt-[440px]"
>
  <!-- Background image + overlay -->
  <div class="absolute inset-0">
    <img
      src={`${import.meta.env.BASE_URL}images/UZ3d55FLdaWNpsvTw0f6JfHZ2Wc.png`}
      alt="Hero Image"
      class="h-full w-full object-cover"
      style="object-position:50% 90%"
      fetchpriority="high"
    />
    <div
      class="absolute inset-0"
      style="background:linear-gradient(rgba(0,0,0,0) 49%, rgba(0,0,0,0.16) 59%, rgba(0,0,0,0.64) 84%)"
    >
    </div>
  </div>

  <!-- Content -->
  <div class="container-site relative z-10">
    <div class="flex flex-col gap-12">
      <h1
        data-reveal
        class="font-display text-[64px] leading-[0.9] tracking-[-0.01em] text-white sm:text-[96px] md:whitespace-nowrap md:text-[128px] lg:text-[176px] lg:leading-[0.7]"
      >
        Tourne-Bride
      </h1>

      <div
        class="flex flex-col items-start gap-8 md:flex-row md:items-center"
        data-reveal
        data-reveal-delay="0.12"
      >
        <p
          class="max-w-[557px] font-heading text-[20px] font-medium leading-[32px] text-white"
        >
          Centre chrétien pour enfants niché au cœur du parc naturel de la Haute
          Sambre, où chacun grandit, s'épanouit et trouve sa place — depuis 1964.
        </p>
        <a
          href={`${import.meta.env.BASE_URL}camps`}
          class="group relative shrink-0 overflow-hidden rounded-full bg-orange px-8 py-[18px]"
        >
          <span class="relative z-10 flex items-center gap-2 font-heading text-[20px] font-bold text-white">
            Découvrir nos camps
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none">
              <path d="M7 17L17 7M17 7H8M17 7v9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span
            class="absolute inset-0 z-0 origin-bottom scale-y-0 bg-[#e05200] transition-transform duration-300 ease-out group-hover:scale-y-100"
          >
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
