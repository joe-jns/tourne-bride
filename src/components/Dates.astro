---
const items = [
  { icon: "calendar", label: "Camps enfants", value: "Vacances scolaires" },
  { icon: "hourglass", label: "Âge", value: "De 7 à 11 ans" },
  { icon: "home", label: "Internat sportif", value: "Marie Durand" },
  { icon: "calendar", label: "Réservations", value: "071 59 19 61" },
];
---

<section class="relative overflow-hidden bg-lime py-[90px]">
  <div class="container-site">
    <!-- Heading -->
    <div class="relative mx-auto max-w-[960px] text-center">
      <span
        data-reveal
        class="relative z-10 inline-block -rotate-3 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
      >
        À noter
      </span>
      <h2
        data-reveal
        data-reveal-delay="0.05"
        class="-mt-4 font-display text-[44px] leading-[1.05] text-forest lg:text-[72px] lg:leading-[76px]"
      >
        Nos prochains rendez-vous
      </h2>
    </div>

    <!-- Row of dates -->
    <div class="mt-14 grid grid-cols-2 gap-y-10 lg:grid-cols-4" data-stagger>
      {
        items.map((it, i) => (
          <div
            data-reveal
            class:list={[
              "px-6 text-center",
              i > 0 && "lg:border-l lg:border-forest/25",
            ]}
          >
            <div class="flex items-center justify-center gap-2 font-heading text-[20px] text-forest">
              {it.icon === "hourglass" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M6 3h12M6 21h12M7 3c0 5 10 5 10 9s-10 4-10 9M17 3c0 5-10 5-10 9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              )}
              {it.icon === "calendar" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <rect x="3" y="5" width="18" height="16" rx="2" stroke="currentColor" stroke-width="1.8"/>
                  <path d="M3 9h18M8 3v4M16 3v4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                </svg>
              )}
              {it.icon === "home" && (
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                  <path d="M4 11l8-7 8 7M6 10v9h12v-9" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}
              {it.label}
            </div>
            {it.value === "countdown" ? (
              <div
                data-countdown="2026-02-19"
                class="mt-3 font-heading text-[26px] font-bold text-forest"
              >
                Camp Starts in <span data-count-days>00</span> Days
              </div>
            ) : (
              <div class="mt-3 font-heading text-[26px] font-bold text-forest">
                {it.value}
              </div>
            )}
          </div>
        ))
      }
    </div>

    <!-- CTA -->
    <div class="mt-14 flex justify-center" data-reveal>
      <a
        href={`${import.meta.env.BASE_URL}contact`}
        class="group relative overflow-hidden rounded-full bg-orange px-8 py-[18px]"
      >
        <span class="relative z-10 font-heading text-[20px] font-bold text-white">
          Nous contacter
        </span>
        <span
          class="absolute inset-0 z-0 origin-bottom scale-y-0 bg-[#e05200] transition-transform duration-300 ease-out group-hover:scale-y-100"
        >
        </span>
      </a>
    </div>
  </div>
</section>
