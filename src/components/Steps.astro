---
const steps = [
  {
    label: "Étape 01",
    title: "Inscription",
    text: "Renseignez-vous sur les places disponibles et remplissez le talon d'inscription en ligne ou par courrier.",
  },
  {
    label: "Étape 02",
    title: "Préparation",
    text: "Recevez le trousseau et toutes les infos utiles : dates, liste des affaires et rappels importants.",
  },
  {
    label: "Étape 03",
    title: "Le séjour",
    text: "Votre enfant arrive prêt à jouer, explorer et se faire de nouveaux amis, encadré par notre équipe.",
  },
  {
    label: "Étape 04",
    title: "Le partage",
    text: "Jeux, veillées, partages bibliques et bons repas : des souvenirs à raconter en famille.",
  },
];
---

<!--
  Pinned scroll section. On desktop the track is 240vh tall and the inner
  content sticks to the top of the viewport: the page "stops descending" while
  the progress bar fills as you scroll, then normal scroll resumes once the
  timeline is complete. On mobile it degrades to a normal, full-height section.
-->
<section data-timeline-pin class="relative bg-forest lg:h-[240vh]">
  <div
    class="flex min-h-[100dvh] flex-col justify-center overflow-hidden py-[90px] lg:sticky lg:top-0 lg:h-screen lg:min-h-0 lg:py-0"
  >
    <div class="mx-auto w-full max-w-[1700px] px-6 lg:px-20" data-timeline>
      <!-- Heading -->
      <div class="relative mx-auto max-w-[900px] text-center">
        <span
          data-reveal
          class="relative z-10 inline-block -rotate-2 rounded-md bg-amber px-3 py-1 font-display text-[18px] leading-none text-forest"
        >
          Comment ça marche
        </span>
        <h2
          data-reveal
          data-reveal-delay="0.05"
          class="-mt-4 font-display text-[44px] leading-[1.05] text-white lg:text-[76px] lg:leading-[80px]"
        >
          De l'inscription au grand départ
          <img
            src={`${import.meta.env.BASE_URL}images/bp8cD6ZRWiiFkH9hCPMVYrST3Q.svg`}
            alt=""
            aria-hidden="true"
            class="absolute right-6 top-2 hidden h-[42px] w-[50px] lg:block"
          />
        </h2>
      </div>

      <!-- Timeline (full width) -->
      <div class="relative mt-10 lg:mt-24">
        <div class="absolute left-0 right-0 top-[9px] hidden h-[3px] rounded-full bg-moss/50 lg:block"></div>
        <div
          data-timeline-fill
          class="absolute left-0 right-0 top-[9px] hidden h-[3px] origin-left rounded-full bg-lime lg:block"
          style="transform:scaleX(0.02)"
        >
        </div>

        <div class="grid grid-cols-1 gap-10 sm:grid-cols-2 lg:grid-cols-4 lg:gap-12">
          {
            steps.map((s, i) => (
              <div class="relative">
                <span
                  data-timeline-dot={i}
                  class:list={[
                    "relative flex h-5 w-5 items-center justify-center rounded-full",
                    i === 0 && "on",
                  ]}
                >
                  <svg width="11" height="11" viewBox="0 0 24 24" fill="none">
                    <path
                      d="M5 12l4 4 10-10"
                      stroke="#123d25"
                      stroke-width="3"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <div class="mt-6">
                  <div class="font-heading text-[20px] font-medium text-lime">{s.label}</div>
                  <h3 class="mt-2 font-heading text-[24px] font-extrabold text-white lg:text-[28px]">
                    {s.title}
                  </h3>
                  <p class="mt-3 max-w-[340px] font-heading text-[18px] leading-[28px] text-mist">
                    {s.text}
                  </p>
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <!-- CTA -->
      <div class="mt-14 flex justify-center lg:mt-20">
        <a
          href={`${import.meta.env.BASE_URL}contact`}
          class="group relative overflow-hidden rounded-full bg-orange px-8 py-[18px]"
        >
          <span class="relative z-10 font-heading text-[20px] font-bold text-white">
            S'inscrire
          </span>
          <span
            class="absolute inset-0 z-0 origin-bottom scale-y-0 bg-[#e05200] transition-transform duration-300 ease-out group-hover:scale-y-100"
          >
          </span>
        </a>
      </div>
    </div>
  </div>
</section>
