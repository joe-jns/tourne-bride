---
interface Props {
  title: string;
  text?: string;
  buttonLabel: string;
  buttonHref: string;
}
const { title, text, buttonLabel, buttonHref } = Astro.props;
const href = import.meta.env.BASE_URL + String(buttonHref).replace(/^\//, "");
---

<section class="bg-lime py-[80px]">
  <div class="container-site text-center">
    <h2
      data-reveal
      class="mx-auto max-w-[860px] font-display text-[36px] leading-[1.05] text-forest lg:text-[60px] lg:leading-[64px]"
    >
      {title}
    </h2>
    {
      text && (
        <p
          data-reveal
          data-reveal-delay="0.08"
          class="mx-auto mt-6 max-w-[600px] font-heading text-[20px] leading-[32px] text-forest/80"
        >
          {text}
        </p>
      )
    }
    <div class="mt-10 flex justify-center" data-reveal data-reveal-delay="0.15">
      <a
        href={href}
        class="group relative overflow-hidden rounded-full bg-orange px-8 py-[18px]"
      >
        <span class="relative z-10 font-heading text-[20px] font-bold text-white">
          {buttonLabel}
        </span>
        <span class="absolute inset-0 z-0 origin-bottom scale-y-0 bg-[#e05200] transition-transform duration-300 ease-out group-hover:scale-y-100"></span>
      </a>
    </div>
  </div>
</section>
