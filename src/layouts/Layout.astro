---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Centre Protestant Tourne-Bride",
  description = "Centre chrétien pour enfants au cœur du parc naturel de la Haute Sambre. Camps, internat et locations dans un cadre naturel exceptionnel, depuis 1964.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}images/qi6XErSOH5xNf7R979ZatYl9rPE.svg`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      import "../scripts/animations.js";
    </script>
  </body>
</html>
